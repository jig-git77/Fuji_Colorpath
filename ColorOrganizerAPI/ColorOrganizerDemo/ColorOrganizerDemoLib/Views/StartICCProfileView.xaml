<UserControl x:Class="ColorOrganizerDemoLib.Views.StartICCProfileView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="800" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Margin="15,20,0,5" BorderBrush="Black" BorderThickness="1">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40*"></ColumnDefinition>
                    <ColumnDefinition Width="60*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Start ICC Profile Creation" FontSize="20" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,5,5,5"></TextBlock>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="View Last Analyse" Name="btnLastAnalyse" HorizontalAlignment="Right" Margin="3,10,3,10" Padding="15,5,15,5" Command="{Binding LastAnalyzeButtonCommand}" IsEnabled="{Binding IsNextButtonEnable}"></Button>
                    <Button Content="Validation" Name="btnValidation" HorizontalAlignment="Right" Margin="3,10,3,10" Padding="15,5,15,5" Command="{Binding ValidationMeasureCommand}" IsEnabled="{Binding ElementName=rbExisting,Path=IsChecked}"></Button>
                    <Button Content="&lt;- Previous" Name="btnPrevious" HorizontalAlignment="Right" Margin="3,10,3,10" Padding="15,5,15,5" Command="{Binding PreviousButtonCommand}"></Button>
                    <Button Content="Next -&gt;" Name="btnNext" HorizontalAlignment="Right" Margin="3,10,15,10" Padding="15,5,15,5" Command="{Binding NextButtonCommand}" IsEnabled="{Binding IsNextButtonEnable}"></Button>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" Margin="15,10,15,20" BorderBrush="Black" BorderThickness="1">
            <StackPanel Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Left">
                <RadioButton GroupName="profile" Name="rbCreate" Content="Create a new ICC Profile" Margin="20,15,5,7" IsChecked="{Binding IsNewIccProfile,Mode=TwoWay}"></RadioButton>
                <StackPanel Orientation="Horizontal" Margin="40,7,5,7">
                    <TextBlock Text="ICC Profile Name:" Margin="10,5,5,5"></TextBlock>
                    <TextBox Name="txtProfileName" Width="200" Margin="10,5,5,5" IsEnabled="{Binding ElementName=rbCreate,Path=IsChecked}" Text="{Binding NewProfileName,Mode=TwoWay}"></TextBox>
                </StackPanel>
                <RadioButton GroupName="profile" Name="rbExisting" Content="Restart the existing project" Margin="20,15,5,7"></RadioButton>
                <StackPanel Orientation="Horizontal" Margin="40,7,5,7">
                    <TextBlock Text="Project ID:" Margin="10,5,5,5"></TextBlock>
                    <TextBox Name="txtProjectName" Width="200" Margin="10,5,5,5" IsEnabled="{Binding ElementName=rbExisting,Path=IsChecked}" Text="{Binding ExistingProjectId,Mode=TwoWay}"></TextBox>
                    <!--<ComboBox Name="cmbProfileName" Width="200" Margin="10,5,5,5" IsEnabled="{Binding ElementName=rbExisting,Path=IsChecked}" ItemsSource="{Binding IccProfiles}" DisplayMemberPath="IccProfileName" SelectedValue="{Binding SelectedIccProfile,Mode=TwoWay}"></ComboBox>-->
                </StackPanel>
                <TextBlock Text="Validation Information" Margin="25,5,5,5"></TextBlock>
                <StackPanel Orientation="Horizontal" Margin="40,7,5,7">
                    <TextBlock Text="Job Name:" Margin="10,5,5,5"></TextBlock>
                    <TextBox Name="txtJobName" Width="200" Margin="10,5,5,5" IsEnabled="{Binding ElementName=rbExisting,Path=IsChecked}" Text="{Binding JobName,Mode=TwoWay}"></TextBox>
                    <!--<ComboBox Name="cmbProfileName" Width="200" Margin="10,5,5,5" IsEnabled="{Binding ElementName=rbExisting,Path=IsChecked}" ItemsSource="{Binding IccProfiles}" DisplayMemberPath="IccProfileName" SelectedValue="{Binding SelectedIccProfile,Mode=TwoWay}"></ComboBox>-->
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="40,7,5,7">
                    <TextBlock Text="Customer:" Margin="10,5,5,5"></TextBlock>
                    <TextBox Name="txtCustomer" Width="200" Margin="10,5,5,5" IsEnabled="{Binding ElementName=rbExisting,Path=IsChecked}" Text="{Binding Customer,Mode=TwoWay}"></TextBox>
                    <!--<ComboBox Name="cmbProfileName" Width="200" Margin="10,5,5,5" IsEnabled="{Binding ElementName=rbExisting,Path=IsChecked}" ItemsSource="{Binding IccProfiles}" DisplayMemberPath="IccProfileName" SelectedValue="{Binding SelectedIccProfile,Mode=TwoWay}"></ComboBox>-->
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="40,7,5,7">
                    <TextBlock Text="Page or Surface:" Margin="10,5,5,5"></TextBlock>
                    <TextBox Name="txtPageOrSurface" Width="200" Margin="10,5,5,5" IsEnabled="{Binding ElementName=rbExisting,Path=IsChecked}" Text="{Binding PageOrSurface,Mode=TwoWay}"></TextBox>
                    <!--<ComboBox Name="cmbProfileName" Width="200" Margin="10,5,5,5" IsEnabled="{Binding ElementName=rbExisting,Path=IsChecked}" ItemsSource="{Binding IccProfiles}" DisplayMemberPath="IccProfileName" SelectedValue="{Binding SelectedIccProfile,Mode=TwoWay}"></ComboBox>-->
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="40,7,5,7">
                    <TextBlock Text="JDF Job Id:" Margin="10,5,5,5"></TextBlock>
                    <TextBox Name="txtJDFJobId" Width="200" Margin="10,5,5,5" IsEnabled="{Binding ElementName=rbExisting,Path=IsChecked}" Text="{Binding JDFJobId,Mode=TwoWay}"></TextBox>
                    <!--<ComboBox Name="cmbProfileName" Width="200" Margin="10,5,5,5" IsEnabled="{Binding ElementName=rbExisting,Path=IsChecked}" ItemsSource="{Binding IccProfiles}" DisplayMemberPath="IccProfileName" SelectedValue="{Binding SelectedIccProfile,Mode=TwoWay}"></ComboBox>-->
                </StackPanel>
                
            </StackPanel>
        </Border>
    </Grid>
</UserControl>