<UserControl x:Class="ColorOrganizerDemoLib.Views.WebHostView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:view="clr-namespace:ColorOrganizerDemoLib.Views"
    xmlns:hh="clr-namespace:Divelements.SilverlightTools;assembly=Divelements.SilverlightTools"
    mc:Ignorable="d"
    d:DesignHeight="800" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"></RowDefinition>
            <RowDefinition Height="40"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Margin="15,20,15,5" BorderBrush="Black" BorderThickness="1">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50*"></ColumnDefinition>
                    <ColumnDefinition Width="50*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Create Device Link Profile With ColorPath" FontSize="20" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,5,5,5"></TextBlock>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="&lt;- Previous" Name="btnPrevious" HorizontalAlignment="Right" Margin="15,10,15,10" Padding="15,5,15,5" Command="{Binding PreviousButtonCommand}"></Button>
                </StackPanel>
            </Grid>
        </Border>
        <TextBlock Name="lblStatus" Grid.Row="1" Margin="15,5,5,5" HorizontalAlignment="Center" FontSize="14" FontWeight="Bold"></TextBlock>
        <Border Grid.Row="2" Margin="15,10,15,20">
            <hh:HtmlHost x:Name="HtmlHostCtrl"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                           SourceUri="http://www.softwebdemo.com/softweb/FujiSync4D/Login.aspx" Visibility="{Binding CurrentStatus}"></hh:HtmlHost>
                <!--<view:HtmlHost x:Name="HtmlHostCtrl"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HostDiv="htmlHost"
                            Url="http://www.softwebdemo.com/softweb/FujiSync4D/Login.aspx" Visibility="{Binding CurrentStatus}"></view:HtmlHost>-->
        </Border>
    </Grid>
</UserControl>