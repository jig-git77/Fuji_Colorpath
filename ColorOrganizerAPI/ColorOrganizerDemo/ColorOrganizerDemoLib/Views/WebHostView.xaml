<UserControl x:Class="ColorOrganizerDemoLib.Views.WebHostView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:view="clr-namespace:ColorOrganizerDemoLib.Views"
    mc:Ignorable="d"
    d:DesignHeight="800" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"></RowDefinition>
            <RowDefinition Height="40"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Margin="15,20,15,5" BorderBrush="Black" BorderThickness="1">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80*"></ColumnDefinition>
                    <ColumnDefinition Width="20*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Create Device Link Profile With ColorPath" FontSize="20" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,5,5,5"></TextBlock>
                <Button Grid.Column="1" Content="Next ->" Name="btnNext" HorizontalAlignment="Right" Margin="15,10,15,10" Padding="15,5,15,5"></Button>
            </Grid>
        </Border>
        <TextBlock Name="lblStatus" Grid.Row="1" Margin="15,5,5,5" HorizontalAlignment="Center" FontSize="14" FontWeight="Bold"></TextBlock>
        <Border Grid.Row="2" Margin="15,10,15,20">
                <view:HtmlHost x:Name="HtmlHostCtrl"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HostDiv="htmlHost"
                            Url="http://www.softwebdemo.com/softweb/FujiSync4D/Login.aspx"></view:HtmlHost>
        </Border>
    </Grid>
</UserControl>