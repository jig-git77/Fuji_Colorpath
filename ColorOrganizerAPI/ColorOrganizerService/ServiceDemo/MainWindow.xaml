<Window x:Class="ServiceDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow" Height="650" Width="800" MaxHeight="650" MaxWidth="800" Loaded="MainWindow_Loaded">
    <DockPanel>
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20*"></ColumnDefinition>
                <ColumnDefinition Width="30*"></ColumnDefinition>
                <ColumnDefinition Width="20*"></ColumnDefinition>
                <ColumnDefinition Width="30*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <TextBlock Grid.Column="0" Text="UserName" Margin="5,5,5,5" HorizontalAlignment="Right"></TextBlock>
            <TextBox Grid.Column="1" Margin="5,5,5,5" Name="txtUserName"></TextBox>
            <TextBlock Grid.Column="2" Text="Password" Margin="5,5,5,5" HorizontalAlignment="Right"></TextBlock>
            <PasswordBox Grid.Column="3" Margin="5,5,5,5" Name="txtPassword"></PasswordBox>

            <TextBlock Grid.Column="0" Grid.Row="1" Text="Select Method" Margin="5,5,5,5" HorizontalAlignment="Right"></TextBlock>
            <ComboBox Grid.Column="1" Grid.Row="1" Margin="5,5,5,5" Name="cmbDeviceList" ItemsSource="{Binding Path=Methods}" SelectedItem="{Binding Path=SelectedMethod}"></ComboBox>
            <Button Grid.Column="2" Grid.Row="1" Name="btnCallService" Content="Make Call" Width="80" HorizontalAlignment="Left" Margin="5,5,5,5" Click="btnCallService_Click"></Button>

            <TextBlock Grid.Column="0" Grid.Row="2" Text="Project Id" Margin="5,5,5,5" HorizontalAlignment="Right"></TextBlock>
            <TextBox Grid.Column="1" Grid.Row="2" Margin="5,5,5,5" Name="txtProjectId"></TextBox>
            <TextBlock Grid.Column="2" Grid.Row="2" Text="Project Temp Id(Guid)" Margin="5,5,5,5" HorizontalAlignment="Right"></TextBlock>
            <TextBox Grid.Column="3" Grid.Row="2" Margin="5,5,5,5" Name="txtProjectTempId"></TextBox>

            <TextBlock Grid.Column="0" Grid.Row="3" Text="ProjectName" Margin="5,5,5,5" HorizontalAlignment="Right"></TextBlock>
            <TextBox Grid.Column="1" Grid.Row="3" Margin="5,5,5,5" Name="txtProjectName"></TextBox>
            <TextBlock Grid.Column="2" Grid.Row="3" Text="Media" Margin="5,5,5,5" HorizontalAlignment="Right"></TextBlock>
            <TextBox Grid.Column="3" Grid.Row="3" Margin="5,5,5,5" Name="txtMedia"></TextBox>
            
            <TextBlock Grid.Column="0" Grid.Row="4" Text="Colorant" Margin="5,5,5,5" HorizontalAlignment="Right"></TextBlock>
            <TextBox Grid.Column="1" Grid.Row="4" Margin="5,5,5,5" Name="txtColorant"></TextBox>
            <TextBlock Grid.Column="2" Grid.Row="4" Text="Rip Settings" Margin="5,5,5,5" HorizontalAlignment="Right"></TextBlock>
            <TextBox Grid.Column="3" Grid.Row="4" Margin="5,5,5,5" Name="txtRipSettings"></TextBox>

            <TextBlock Name="lblStatus" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="4" HorizontalAlignment="Left" Margin="5,5,5,5"></TextBlock>
        </Grid>
        <DataGrid Name="dgResult" AutoGenerateColumns="True" DockPanel.Dock="Bottom" Margin="10,10,10,10"></DataGrid>
    </DockPanel>
</Window>