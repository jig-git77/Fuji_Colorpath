<Window x:Class="ServiceDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow" Height="650" Width="800" MaxHeight="650" MaxWidth="800" Loaded="MainWindow_Loaded">
    <DockPanel>
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20*"></ColumnDefinition>
                <ColumnDefinition Width="30*"></ColumnDefinition>
                <ColumnDefinition Width="20*"></ColumnDefinition>
                <ColumnDefinition Width="30*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <TextBlock Grid.Column="0" Grid.Row="0" Text="Select service end-point" Margin="5,5,5,5" HorizontalAlignment="Right"></TextBlock>
            <Grid Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Grid.Row="0" Margin="5,5,5,5" >
                    <RadioButton Name="rbtnLocal" Content="Local" GroupName="ServiceEndPoint" Click="rbtnServiceEndPoints_Click"></RadioButton>
                    <RadioButton Name="rbtnDevTaskero" Content="dev.taskero.com" GroupName="ServiceEndPoint" Click="rbtnServiceEndPoints_Click"></RadioButton>
                    <RadioButton Name="rbtnOther" Content="Other" GroupName="ServiceEndPoint" Click="rbtnServiceEndPoints_Click"></RadioButton>
                </StackPanel>
                <StackPanel Grid.Column="1" Grid.Row="0" Margin="5,5,5,5" >
                    <TextBlock Name="tbLocal" Text="https://localhost/ColorOrganizerService/Sync4D.svc" Visibility="Hidden"></TextBlock>
                    <TextBlock Name="tbDevTaskero" Text="http://dev.taskero.com/Services/ColorOrganizerService/Sync4D.svc" Visibility="Hidden"></TextBlock>
                    <TextBox Name="txtOther" Visibility="Hidden" Text="https://localhost/ColorOrganizerService/Sync4D.svc"></TextBox>
                </StackPanel>

            </Grid>

            <TextBlock Grid.Column="0" Grid.Row="1" Text="UserName" Margin="5,5,5,5" HorizontalAlignment="Right"></TextBlock>
            <TextBox Grid.Column="1" Grid.Row="1" Margin="5,5,5,5" Name="txtUserName"></TextBox>
            <TextBlock Grid.Column="2" Grid.Row="1" Text="Password" Margin="5,5,5,5" HorizontalAlignment="Right"></TextBlock>
            <PasswordBox Grid.Column="3" Grid.Row="1" Margin="5,5,5,5" Name="txtPassword"></PasswordBox>

            <TextBlock Grid.Column="0" Grid.Row="2" Text="Select Method" Margin="5,5,5,5" HorizontalAlignment="Right"></TextBlock>
            <ComboBox Grid.Column="1" Grid.Row="2" Margin="5,5,5,5" Name="cmbDeviceList" ItemsSource="{Binding Path=Methods}" SelectedItem="{Binding Path=SelectedMethod}"></ComboBox>
            <Button Grid.Column="2" Grid.Row="2" Name="btnCallService" Content="Make Call" Width="80" HorizontalAlignment="Left" Margin="5,5,5,5" Click="btnCallService_Click"></Button>
            <Button Grid.Column="3" Grid.Row="2" Name="btnCallAllServices" Content="Check Service Calls" Width="150" HorizontalAlignment="Left" Margin="5,5,5,5" Click="btnCallAllServices_Click"></Button>

            <TextBlock Grid.Column="0" Grid.Row="3" Text="Project Id" Margin="5,5,5,5" HorizontalAlignment="Right"></TextBlock>
            <TextBox Grid.Column="1" Grid.Row="3" Margin="5,5,5,5" Name="txtProjectId"></TextBox>
            <TextBlock Grid.Column="2" Grid.Row="3" Text="Project Temp Id(Guid)" Margin="5,5,5,5" HorizontalAlignment="Right"></TextBlock>
            <TextBox Grid.Column="3" Grid.Row="3" Margin="5,5,5,5" Name="txtProjectTempId"></TextBox>

            <TextBlock Grid.Column="0" Grid.Row="4" Text="ProjectName" Margin="5,5,5,5" HorizontalAlignment="Right"></TextBlock>
            <TextBox Grid.Column="1" Grid.Row="4" Margin="5,5,5,5" Name="txtProjectName"></TextBox>
            <TextBlock Grid.Column="2" Grid.Row="4" Text="Media" Margin="5,5,5,5" HorizontalAlignment="Right"></TextBlock>
            <TextBox Grid.Column="3" Grid.Row="4" Margin="5,5,5,5" Name="txtMedia"></TextBox>

            <TextBlock Grid.Column="0" Grid.Row="5" Text="Colorant" Margin="5,5,5,5" HorizontalAlignment="Right"></TextBlock>
            <TextBox Grid.Column="1" Grid.Row="5" Margin="5,5,5,5" Name="txtColorant"></TextBox>
            <TextBlock Grid.Column="2" Grid.Row="5" Text="Rip Settings" Margin="5,5,5,5" HorizontalAlignment="Right"></TextBlock>
            <TextBox Grid.Column="3" Grid.Row="5" Margin="5,5,5,5" Name="txtRipSettings"></TextBox>

            <TextBlock Grid.Column="0" Grid.Row="6" Text="ProfileType" Margin="5,5,5,5" HorizontalAlignment="Right"></TextBlock>
            <ComboBox Grid.Column="1" Grid.Row="6" Margin="5,5,5,5" Name="cmbProfileType" ItemsSource="{Binding ProfileTypes}" DisplayMemberPath="Value" SelectedValuePath="Key"></ComboBox>
            <TextBlock Grid.Column="2" Grid.Row="6" Text="Reference Chart Id" Margin="5,5,5,5" HorizontalAlignment="Right"></TextBlock>
            <TextBox Grid.Column="3" Grid.Row="6" Margin="5,5,5,5" Name="txtRefChartId"></TextBox>

            <TextBlock Name="lblStatus" Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="4" HorizontalAlignment="Left" Margin="5,5,5,5"></TextBlock>
        </Grid>
        <DataGrid Name="dgResult" AutoGenerateColumns="True" DockPanel.Dock="Bottom" Margin="10,10,10,10">
        </DataGrid>
    </DockPanel>
</Window>