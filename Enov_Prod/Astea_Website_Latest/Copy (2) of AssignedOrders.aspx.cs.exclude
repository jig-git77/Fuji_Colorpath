using System;
using System.Data;
using System.Data.SqlClient;
using System.Configuration;
using System.Collections;
using System.Web;
using System.Web.Security;
using System.Web.UI;
using System.Web.UI.WebControls;
using System.Web.UI.WebControls.WebParts;
using System.Web.UI.HtmlControls;

public partial class AssignedOrders : System.Web.UI.Page
{
    protected SqlConnection ordercon;
    protected string connectionString = ConfigurationManager.ConnectionStrings["EnovationConnectionString"].ConnectionString;
    protected void Page_Load(object sender, EventArgs e)
    {
        

        if (!Page.IsPostBack)
        {
            // Initialize the data source
                //Logout if session expires
                if ( Session["UserID"] == null)
                {
                    Response.Redirect("EnovationLogin.aspx", false);
                }
                string saID = Session["UserID"].ToString();
                ordercon = new SqlConnection(connectionString);
                ordercon.Open(); //open connection
                string orderCommand = "select order_line.order_id, order_line.site_company_descr, service_call.bpart_id, order_line.problem_desc, CASE when sce.resolve_text is null  then '' 	when sce.resolve_text = '' then '' else SUBSTRING(sce.resolve_text,0,30) + '...' end as resolve_text, CASE order_line.Order_Stat_Uniq_Id WHEN 400 THEN 1 ELSE 0  END As 'Status' from order_line" + " " +
                    "inner join service_call on order_line.order_id=service_call.order_id inner join service_call_env as sce on sce.order_id = service_call.order_id  where order_line.order_stat_uniq_id < 450 and service_call.sa_person_id='" + saID + "' order by order_line.order_id asc ";
                SqlDataAdapter orderAdapt = new SqlDataAdapter(orderCommand, ordercon);

                DataSet orderDs = new DataSet();
                orderAdapt.Fill(orderDs);

                // ( filling and binding dataset)
                GridView1.DataSource = orderDs;
                GridView1.DataBind();
                        
        }


    }

    protected void ExitButton_Click(object sender, EventArgs e)
    {
        // Dispose Session Variables
        Session.RemoveAll();
        Session.Abandon();
        Response.Redirect("EnovationLogin.aspx");
    }

    protected void CheckBox1_CheckedChanged1(object sender, EventArgs e)
    {
   
       try
       { 
        CheckBox cb = sender as CheckBox;
      
        GridViewRow gr = cb.Parent.Parent as GridViewRow;
        string key = GridView1.DataKeys[gr.DataItemIndex].Value.ToString();

        string dateLocale = _UserLocalDT.Value.ToString();
        DateTime UserLocalDT = DateTime.Now;
        
        DateTime.TryParse(dateLocale, out UserLocalDT); 
  
        //do an update using order_id
        BusinessLogic.UpdateCallStatusToOnSite(key, UserLocalDT);
       

        cb.Enabled = false;
        cb.Checked = false;
        }
        catch (  Exception exc ) 
        {
            lblError.Text = exc.ToString();
        }
        
    }

    protected void GridView1_RowCreated(Object sender, GridViewRowEventArgs e)
    {
        CheckBox chk; 

        // The GridViewCommandEventArgs class does not contain a 
        // property that indicates which row's command button was
        // clicked. To identify which row's button was clicked, use 
        // the button's CommandArgument property by setting it to the 
        // row's index.
        if (e.Row.RowType == DataControlRowType.DataRow)
        {
            chk = (CheckBox)e.Row.FindControl("CheckBox1"); ;
             chk.CheckedChanged += CheckBox1_CheckedChanged1;
 
            
        }

    }


}
