<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<appSettings>
		<add key="ServiceAlliancePath" value="C:\Program Files\AllianceEnterprise 5\ServiceAlliance\Application\Seal5.exe"></add>
		<add key="profile" value="-dbp Enov_Test"></add>
		<add key="uid" value="-uid Seal"></add>
		<add key="pwd" value="-pwd xxxxxx"></add>
		<add key="Email_TO" value="cshah@fujifilmgs.com"></add>
		<add key="Email_CC" value="cshah@fujifilmgs.com,cshah@fujifilmgs.com"></add>
		<add key="Server_Name" value="bishop"></add>

	</appSettings>
	<connectionStrings>
		<add name="DBConn_EnovProd" connectionString="Data Source=opal.enterprise.enovationgraphics.com;Initial Catalog=Enov_Test;Persist Security Info=True;User ID=sa;Password=;Application Name=RestartAPIBroker;" providerName="System.Data.SqlClient"/>
		<add name="DBConn_XPSMTP" connectionString="Data Source=VALFGSU-ASTDBP1.enterprise.enovationgraphics.com;Initial Catalog=Enov_Test;Persist Security Info=True;User ID=sa;Password=;Application Name=RestartAPIBroker;" providerName="System.Data.SqlClient"/>
	</connectionStrings>
	<system.diagnostics>
        <sources>
            <!-- This section defines the logging configuration for My.Application.Log -->
            <source name="DefaultSource" switchName="DefaultSwitch">
                <listeners>
                    <add name="FileLog"/>
                    <!-- Uncomment the below section to write to the Application Event Log -->
                    <!--<add name="EventLog"/>-->
                </listeners>
