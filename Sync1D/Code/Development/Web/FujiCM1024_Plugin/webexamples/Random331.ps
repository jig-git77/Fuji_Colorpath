<< /PageSize [613 792] >> setpagedevice

%%BeginProlog

% arbitrary rectangle
% arguments: w h x y
/rect { gsave 
newpath
moveto
dup 0.0 exch rlineto
exch 0.0  rlineto
0.0 exch neg rlineto
closepath
fill
grestore } bind def

% hexagon with bottom left origin
% arguments: w h x y
/hex { gsave 
newpath
moveto
0 1 index rlineto
1 index 2 div 1 index 2 div rlineto
1 index 2 div 1 index 2 div neg rlineto
0 1 index neg rlineto
1 index 2 div neg 1 index 2 div neg rlineto
pop pop
closepath
fill
grestore } bind def

% set times-roman font
% argument: scale
/scaleTimes {
/Times-Roman findfont
exch scalefont
setfont } bind def

% Print a centered string
% argument: string, x, y
/centerShow {
gsave translate
newpath 0.0 0.0 moveto dup true charpath pathbbox
3 -1 roll sub exch 3 -1 roll sub
-0.5 mul exch -0.5 mul
moveto show grestore} bind def

% Print a vertically centered string
% argument: string, x, y
/vcenterShow {
gsave translate 90.0 rotate
newpath 0.0 0.0 moveto dup true charpath pathbbox
3 -1 roll sub exch 3 -1 roll sub
-0.5 mul exch -0.5 mul
moveto show grestore} bind def
%%EndProlog

