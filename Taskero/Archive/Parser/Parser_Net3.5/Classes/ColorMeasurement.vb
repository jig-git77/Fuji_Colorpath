Public Sub Save()
    Dim objCmd As New SqlCommand()
    Try
            
        'Check existence of certain params
        With objCmd
            .CommandText = "dbo.uspInsertCPColorMeasurement"
            .CommandType = CommandType.StoredProcedure
        End With
           

        'GUID that uniquely identified this measurements
        objCmd.Parameters.AddWithValue("@CPMeasurementGUID",Me._MeasurementGuid)

        'Originator 
        objCmd.Parameters.AddWithValue("@Originator", Me._Originator)

        'CREATED
        objCmd.Parameters.AddWithValue("@MeasurementDate",Me._MeasurementDT)

        'CREATED-GMT
        objCmd.Parameters.AddWithValue("@MeasurementGMT",Me._MeasurementGMT)

        'Target Name
        objCmd.Parameters.AddWithValue("@Target_Name",Me._TargetName)

        'Proof Supplier
        If Not IsNothing(Me._ProofSupplier) = True Then
            objCmd.Parameters.AddWithValue("@Proof_Supplier", Me._ProofSupplier)
        End If

        'Target File
        objCmd.Parameters.AddWithValue("@Target_File", Me._TargetFile)

                    
        'Dongle Number
        objCmd.Parameters.AddWithValue("@CPSerialNUM",Me._DongleNumber)            
        
        'Delta E Type
        If CType(Me._dEType,Integer) = 0 Then
            objCmd.Parameters.AddWithValue("@deltaEType", 1)
        Else
            objCmd.Parameters.AddWithValue("@deltaEType", 4)
        End If

        objCmd.Parameters.AddWithValue("@CPVClientMID", Me._CPVClientID)


        '*****Start Tolerance Values
        'Target Tolerance Paper dE
        objCmd.Parameters.AddWithValue("@Targ_Paper_dE",Me._Targ_Paper_dE)

        'Target Tolerance Average dE
        objCmd.Parameters.AddWithValue("@Targ_Avg_dE", Me._Targ_Avg_dE)        
        
        'Targ_Maximum_dE 
        objCmd.Parameters.AddWithValue("@Targ_Maximum_dE", Me._Targ_Maximum_dE)

        'Primary Limit
        objCmd.Parameters.AddWithValue("@Targ_Primary_dE", Me._Targ_Primary_dE)

        'Priamry Limit DH
        If Me._Targ_Primary_DH.HasValue = True Then
            objCmd.Parameters.AddWithValue("@Targ_Primary_DH", Me._Targ_Primary_DH)
        End If
                
        'GRAY_AVERAGE_LIMIT_DH 
        If Me._Targ_Gray_DH.HasValue = True Then
            objCmd.Parameters.AddWithValue("@Targ_Gray_DH",Me._Targ_Gray_DH)
        End If
        
        '****For Large Charts
        If Me._Targ_95PCT_Quantile.HasValue = True Then
            objCmd.Parameters.AddWithValue("@Targ_95PCT_Quantile",  Me._Targ_95PCT_Quantile)  
        End If
        If Me._Targ_Avg_OuterArea.HasValue = True Then
            objCmd.Parameters.AddWithValue("@Targ_Avg_OuterArea",  Me._Targ_Avg_OuterArea)  
        End If

        '***Strict Tolerance Values
        If Me._TargStrict_Paper_dE.HasValue = True Then
