Public Sub Save()
    Dim objCmd As New SqlCommand()
    Try
            
        'Check existence of certain params
    
        
        With objCmd 
            .CommandText = "dbo.uspInsertCPPlateMeasurement"
            .CommandType = CommandType.StoredProcedure
        End With
           

        'GUID that uniquely identified this measurements
        objCmd.Parameters.AddWithValue("@CPMeasurementGUID",Me._MeasurementGuid)

        'Originator 
        objCmd.Parameters.AddWithValue("@Originator", Me._Originator)

        'CREATED
        objCmd.Parameters.AddWithValue("@MeasurementDate",Me._MeasurementDT)

        'CREATED-GMT
        objCmd.Parameters.AddWithValue("@MeasurementGMT",Me._MeasurementGMT)

        'Target Name
        objCmd.Parameters.AddWithValue("@Target_Name",Me._TargetName)


        'Proof Supplier
        If Not IsNothing(Me._ProofSupplier) = True Then
            objCmd.Parameters.AddWithValue("@Proof_Supplier", Me._ProofSupplier)
        End If
        
        'Target File
        objCmd.Parameters.AddWithValue("@Target_File", Me._TargetFile)
               
        'Dongle Number
        objCmd.Parameters.AddWithValue("@CPSerialNUM",Me._DongleNumber.Trim())            
        
        'CPV Client MeasurementID
        objCmd.Parameters.AddWithValue("@CPVClientMID", Me._CPVClientID)

        '*************************************************************************
        '************************* Target Values *********************************         
   
        'Target Avg Negative Dot Area
        objCmd.Parameters.AddWithValue("@Targ_AvgNeg_DotArea",Me._Targ_AvgNeg_DotArea)

        'Target Avg Positive Dot Area
        objCmd.Parameters.AddWithValue("@Targ_AvgPos_DotArea", Me._Targ_AvgPos_DotArea)        
        
        'Target Max Negative Dot Area
        If Me._Targ_MaxNeg_DotArea.HasValue = True Then
            objCmd.Parameters.AddWithValue("@Targ_MaxNeg_DotArea", Me._Targ_MaxNeg_DotArea   )
        End IF
        
         'Target Max Positive
        If Me._Targ_MaxPos_DotArea.HasValue = True Then
            objCmd.Parameters.AddWithValue("@Targ_MaxPos_DotArea", Me._Targ_MaxPos_DotArea)
        End If
       
        '***************************************************************************     

        '**********************************************************************
        '******************     Measured Values     *************************** 
    
        'Average Negative Dot Area
        objCmd.Parameters.AddWithValue("@AvgNeg_DotArea", Me._AvgNeg_DotArea)
        
        'Average Positive Dot Area
        objCmd.Parameters.AddWithValue("@AvgPos_DotArea",Me._AvgPos_DotArea)

        'Max Negative Dot Area
        If Me._MaxNeg_DotArea.HasValue = True Then
            objCmd.Parameters.AddWithValue("@MaxNeg_DotArea",Me._MaxNeg_DotArea)
        End If

        'Max Negative Dot Area Patch
        If (Me._MaxNeg_DotArea.HasValue = True) AndAlso (Not IsNothing(Me._MaxNeg_DotAreaPatch) = True) Then
            objCmd.Parameters.AddWithValue("@MaxNeg_DotAreaPatch", Me._MaxNeg_DotAreaPatch)
        End IF

        'Max Positive Dot Area
        If Me._MaxPos_DotArea.HasValue = True Then
            objCmd.Parameters.AddWithValue("@MaxPos_DotArea", Me._MaxPos_DotArea)
        End If
        
        'Max Positive Dot Area Patch
        If (Me._MaxPos_DotArea.HasValue = True) AndAlso (Not IsNothing(Me._MaxPos_DotAreaPatch) = True) Then
            objCmd.Parameters.AddWithValue("@MaxPos_DotAreaPatch", Me._MaxPos_DotAreaPatch)
        End If
        
        '******************* End Measured Values *********************************
        '*************************************************************************


        'User
        If Not IsNothing(Me._User) = True Then
            objCmd.Parameters.AddWithValue("@User", Me._User)
        End IF

        'Cutstomer
        If Not IsNothing(Me._Customer) = True Then
            objCmd.Parameters.AddWithValue("@Customer", Me._Customer)
        End IF

        'Job
        If Not IsNothing(Me._Job) = True Then
            objCmd.Parameters.AddWithValue("@Job", Me._Job)
        End IF

        'Proofer
        If Not IsNothing(Me._Proofer) = True Then
            objCmd.Parameters.AddWithValue("@Proofer",Me._Proofer)
        End If
              
        'Info
        If Not IsNothing(Me._Info) = True Then
            objCmd.Parameters.AddWithValue("@Info", Me._Info)
        End IF

        'Status
        objCmd.Parameters.AddWithValue("@Status",CType(Me._ProofSatus,Integer))
        
        'Printer Make
        objCmd.Parameters.AddWithValue("@PrinterMake",Me._PrinterMake)

        'Printer Model
        objCmd.Parameters.AddWithValue("@PrinterModel",Me._PrinterModel)
  
        'Printer Serial Number
        If Not IsNothing(Me._PrinterSerialNum) = True Then
            objCmd.Parameters.AddWithValue("@PrinterSerialNum", Me._PrinterSerialNum)
        End IF        

        'Rip type
        If Not IsNothing(Me._RipType) = True Then
            objCmd.Parameters.AddWithValue("@RipType", Me._RipType)
        End If
            
        '*************************************************************************
        '***********************Measuring Instrument****************************
        'Instrument
        If Not IsNothing(Me._Instrument) = True Then 
            objCmd.Parameters.AddWithValue("@Instrument", Me._Instrument)
        End IF

        'Instrument Serial Num
        If Not IsNothing(Me._Instrument_SerialNum) = True Then
            objCmd.Parameters.AddWithValue("@Instrument_SerialNum", Me._Instrument_SerialNum)
        End If
        
        'Illuminant
        If Not IsNothing(Me._Illuminant) = True Then
            objCmd.Parameters.AddWithValue("@Illuminant", Me._Illuminant)
        End If

        'Filter
        If Not IsNothing(Me._Filter) = True Then
            objCmd.Parameters.AddWithValue("@Filter", Me._Filter)
        End If    

        'Observer Type
        If Not IsNothing(Me._ObserverType) = True Then
            objCmd.Parameters.AddWithValue("@ObserverType", Me._ObserverType)
        End If

        '**************************************************************************
                       
        'Substrate
        If Not IsNothing(Me._Substrate) = True Then
            objCmd.Parameters.AddWithValue("@Substrate",Me._Substrate)
        End If
        

        'Substrate/SKU
        If Not IsNothing(Me._SubstrateSKU) = True Then
            objCmd.Parameters.AddWithValue("@Substrate_SKU", Me._SubstrateSKU)  
        End If
             

        'Substrate/Batch
        If Not IsNothing(Me._SubstrateBatch) = True Then
            objCmd.Parameters.AddWithValue("@Substrate_Batch", Me._SubstrateBatch)
        End If
       
        If Not IsNothing(Me._OutputCategory) = True Then
            objCmd.Parameters.AddWithValue("@OutputCategory", Me._OutputCategory)
        End If

        'Output Separation
        If Not IsNothing(Me._OutputSeparation) = True Then
            objCmd.Parameters.AddWithValue("@OutputSeparation" , Me._OutputSeparation)        
        End If        

        'OutputResolution
        If Not IsNothing(Me._OutputResolution) = True Then
            objCmd.Parameters.AddWithValue("@OutputResolution",Me._OutputResolution)
        End IF

        'Output LineScreen
        If Not IsNothing(Me._OutputLineScreen) = True Then
            objCmd.Parameters.AddWithValue("@OutputLineScreen", Me._OutputLineScreen)
        End If

        'Output Dot Shape
        If Not IsNothing(Me._OutputDotShape) = True Then 
            objCmd.Parameters.AddWithValue("@OutputDotShape", Me._OutputDotShape)
        End If

        'Number of Patch Lines
        objCmd.Parameters.AddWithValue("@NumOfPatchLines", Me._NumOfPatchLines)

        'Number of Patches
        objCmd.Parameters.AddWithValue("@NumOfPatches",Me._NumOfPatches)
 
        'Save Measurement Data
        Dim objDataAccess As New DataAccess
        objDataAccess.ExecuteNonQuery(objCmd)
   
 
        'Now Save Each Individual Patches
        For Each MeasuredPatch As MeasuredPatch_Plate In MeasuredPatches
           MeasuredPatch.SavePatchData()
        Next

    Catch ex As Exception
        Throw New Exception("Exception thrown in Measurement Class - Save: " & ex.ToString)
    End Try
End Sub

Public Sub Delete()

    Dim objCmd As New SqlCommand()
    Try

        'Check existence of certain params
        With objCmd
            .CommandText = "dbo.uspDeleteCPMeasurement"
            .CommandType = CommandType.StoredProcedure
        End With

        objCmd.Parameters.AddWithValue("@CPMeasurementGUID", Me._MeasurementGuid)

        Dim objDataAccess As New DataAccess
        objDataAccess.ExecuteNonQuery(objCmd)

    Catch ex As SqlException
        Throw New Exception("SQL Exception thrown in Measurement Class - Save: " & ex.ToString)
    Catch ex As Exception
        Throw New Exception("Exception thrown in Measurement Class - Save: " & ex.ToString)
    End Try

End Sub


End Class
