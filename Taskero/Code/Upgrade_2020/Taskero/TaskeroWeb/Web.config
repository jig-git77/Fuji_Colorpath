<configuration>
  <appSettings>
    <add key="ConnectionString" value="User ID=taskeroprod;Initial Catalog=TaskeroProd;Data Source=115.115.91.48;Password=yS8H3yLn;Pooling=true;Application Name=TaskeroProd;" />
    <add key="Domain" value="http://localhost/TaskeroWeb/" />
    <add key="Email" value="psylvester@fujifilm.com" />
    <add key="Email_FROM" value="TaskeroUniverse@taskero.com" />
    <add key="Pass" value="" />
    <add key="SMTP" value="mailhost.ffusa.com" />
    <add key="ErrorLogType" value="E" />
    <!--D=DataBase , E=Email , B=Both-->
    <add key="ChartHttpHandler" value="Storage=memory;Timeout=180;Url=~/temp/;" />
    <!-- Entry in database of user accessed pages : value=true : Allow entry in database, value=false : Not Allow -->
    <add key="TrackUserAccessedPages" value="false" />
    <add key="ImageURL" value="http://localhost/TaskeroWeb/" />
  </appSettings>
  <!-- Chirag Addes this so that web.config settings do not get inherited in the child app-->
  <location path="." inheritInChildApplications="false" />
  <system.web>
    <compilation debug="true" targetFramework="4.5" />
    <httpRuntime targetFramework="4.5" maxRequestLength="152400" executionTimeout="3600" />
    <webServices>
      <protocols>
        <add name="HttpGet" />
        <add name="HttpPost" />
        <add name="HttpSoap" />
      </protocols>
    </webServices>
    <httpHandlers>
      <remove verb="POST,GET" path="Upload.axd" />
      <add verb="POST,GET" path="Upload.axd" validate="false" type="Upload" />
      <add path="ChartAxd.axd" verb="*" type="Dundas.Charting.WebControl.ChartHttpHandler" validate="false" />
      <add path="Telerik.RadUploadProgressHandler.aspx" verb="*" type="Telerik.WebControls.RadUploadProgressHandler, RadUpload.Net2" />    
    </httpHandlers>

    <httpModules>
      <add name="RadUploadModule" type="Telerik.WebControls.RadUploadHttpModule, RadUpload.Net2" />      
    </httpModules>
    <!-- 
            Set compilation debug="true" to insert debugging 
            symbols into the compiled page. Because this 
            affects performance, set this value to true only 
            during development.
        -->
    <!--<compilation debug="true" targetFramework="4.5">
      <assemblies>
        -->
    <!--<add assembly="System.Web.Extensions, Version=1.0.61025.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35"/>-->
    <!--
      </assemblies>
    </compilation>-->
    <!--
            The <authentication> section enables configuration 
            of the security authentication mode used by 
            ASP.NET to identify an incoming user. 
        -->
    <authentication mode="Windows" />
    <!--
            The <customErrors> section enables configuration 
            of what to do if/when an unhandled error occurs 
            during the execution of a request. Specifically, 
            it enables developers to configure html error pages 
            to be displayed in place of a error stack trace.

        <customErrors mode="RemoteOnly" defaultRedirect="GenericErrorPage.htm">
            <error statusCode="403" redirect="NoAccess.htm" />
            <error statusCode="404" redirect="FileNotFound.htm" />
        </customErrors>
        -->
    <sessionState timeout="60" />
    <!-- changed by CSS on 1/19/10 Increase session state timeout to 60 minutes -->
    <pages controlRenderingCompatibilityVersion="3.5" clientIDMode="AutoID" />
  </system.web>
  <!-- New Added Manish-->
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <handlers>
      <add name="Upload" verb="POST,GET" path="Upload.axd" type="Upload" />
      <add name="ChartAxd" path="ChartAxd.axd" verb="*" type="Dundas.Charting.WebControl.ChartHttpHandler" />
    </handlers>
