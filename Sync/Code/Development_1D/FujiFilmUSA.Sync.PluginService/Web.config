  <!--
    For a description of web.config changes see http://go.microsoft.com/fwlink/?LinkId=235367.

    The following attributes can be set on the <httpRuntime> tag.
      <system.Web>
        <httpRuntime targetFramework="4.8" />
      </system.Web>
  -->
  <system.web>
    <compilation debug="true" targetFramework="4.8"/>
    <httpRuntime targetFramework="4.5.2"/>
  </system.web>
  <system.serviceModel>
    <serviceHostingEnvironment aspNetCompatibilityEnabled="true" multipleSiteBindingsEnabled="true"/>
    <behaviors>
      <endpointBehaviors>
        <behavior name="FujiFilmUSA.Sync.PluginService.PluginDataServiceAspNetAjaxBehavior">
          <webHttp helpEnabled="true" defaultOutgoingResponseFormat="Json"/>
          <dataContractSerializer maxItemsInObjectGraph="2147483647"/>
        </behavior>
      </endpointBehaviors>
      <serviceBehaviors>
        <behavior>
          <!-- To avoid disclosing metadata information, set the values below to false before deployment -->
          <serviceMetadata httpGetEnabled="true" httpsGetEnabled="true"/>
          <!-- To receive exception details in faults for debugging purposes, set the value below to true.  Set to false before deployment to avoid disclosing exception information -->
          <serviceDebug includeExceptionDetailInFaults="false"/>
        </behavior>
        <!--<behavior name="FujiFilmUSA.Sync.PluginService.PluginDataServiceBehaviour">
          <serviceMetadata httpGetEnabled="true" />
          <serviceDebug includeExceptionDetailInFaults="true" />
          <dataContractSerializer maxItemsInObjectGraph="500000000"/>
        </behavior>-->
      </serviceBehaviors>
    </behaviors>
    <services>
      <service name="FujiFilmUSA.Sync.PluginService.PluginData">
        <endpoint address="" behaviorConfiguration="FujiFilmUSA.Sync.PluginService.PluginDataServiceAspNetAjaxBehavior" binding="webHttpBinding" contract="FujiFilmUSA.Sync.PluginService.IPluginData" bindingConfiguration="WebHttpBindingCommon"/>
        <!--<host>
          <baseAddresses>
            <add baseAddress="http://localhost/PluginData" />
          </baseAddresses>
        </host>-->
      </service>
    </services>
    <bindings>
      <webHttpBinding>
        <binding name="WebHttpBindingCommon" maxReceivedMessageSize="500000000" maxBufferSize="500000000"/>
      </webHttpBinding>
    </bindings>
    <!--<bindings>
    <wsHttpBinding>
        <binding name="wsHttpBinding" maxReceivedMessageSize="500000000" maxBufferSize="500000000">          
        </binding>
      </wsHttpBinding>  
    </bindings>-->
  </system.serviceModel>
  <system.webServer>
    <modules runAllManagedModulesForAllRequests="true"/>
    <!--
        To browse web app root directory during debugging, set the value below to true.
        Set to false before deployment to avoid disclosing web app folder information.
      -->
    <directoryBrowse enabled="true"/>
  </system.webServer>
