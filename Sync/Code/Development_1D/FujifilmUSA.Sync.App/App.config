<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5.2" />
  </startup>
  <system.serviceModel>
    <behaviors>
      <endpointBehaviors>
        <behavior name="FujifilmUSA.Sync.Web.Services.PluginDataServiceAspNetAjaxBehavior">
          <webHttp helpEnabled="true" defaultOutgoingResponseFormat="Json" defaultBodyStyle="Wrapped"  />
          <dataContractSerializer maxItemsInObjectGraph="2147483647" />
        </behavior>        
      </endpointBehaviors>
    </behaviors>
    <serviceHostingEnvironment aspNetCompatibilityEnabled="true" />
    <!--<services>
      <service name="FujifilmUSA.Sync.Web.Services.PluginDataService">
        <endpoint address="" behaviorConfiguration="FujifilmUSA.Sync.Web.Services.PluginDataServiceAspNetAjaxBehavior" binding="webHttpBinding" contract="FujifilmUSA.Sync.Web.Services.PluginDataService" bindingConfiguration="WebHttpBindingCommon" />
      </service>
    </services>-->
    <bindings>
      <webHttpBinding>
        <binding name="WebHttpBindingCommon" maxReceivedMessageSize="500000000" maxBufferSize="500000000" />
      </webHttpBinding>      
    </bindings>
    <client>
      <endpoint address="http://localhost/FujifilmUSA.Sync.PluginService/PluginData.svc"
                binding="webHttpBinding" name="WebHttpBindingCommon" 
                bindingConfiguration="WebHttpBindingCommon"                
                behaviorConfiguration="FujifilmUSA.Sync.Web.Services.PluginDataServiceAspNetAjaxBehavior">
        <!--<identity>
          <dns value="localhost" />
        </identity>-->        
      </endpoint>
    </client>
  </system.serviceModel>
  <!--<system.serviceModel>
    <behaviors>
      <serviceBehaviors>
        <behavior name="FujifilmUSA.Sync.Web.Services.PluginDataServiceAspNetAjaxBehavior">
          <serviceMetadata httpGetBinding="True"/>
        </behavior>
      </serviceBehaviors>
    </behaviors>
    <services>
      <service name="FujiFilmUSA.Sync.PluginService.PluginData" behaviorConfiguration="FujifilmUSA.Sync.Web.Services.PluginDataServiceAspNetAjaxBehavior" >
        <endpoint address=""                  
                  binding="webHttpBinding" 
                  contract="FujiFilmUSA.Sync.PluginService.IPluginData" 
                  bindingConfiguration="WebHttpBindingCommon" />
      </service>
    </services>
  </system.serviceModel>-->
</configuration>