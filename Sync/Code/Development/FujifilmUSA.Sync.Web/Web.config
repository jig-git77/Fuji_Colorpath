<configuration>
  <appSettings>
    <add key="IUserBusiness" value="FujifilmUSA.Sync.Business.Implementation.UserBusinessImpl" />
    <!--<add key="ISyncDeviceBusiness" value="FujifilmUSA.Sync.Business.Implementation.SyncDeviceBusinessImpl" />
    <add key="ICompanyBusiness" value="FujifilmUSA.Sync.Business.Implementation.CompanyBusinessImpl" />
    <add key="IBranchBusiness" value="FujifilmUSA.Sync.Business.Implementation.BranchBusinessImpl" />
    <add key="IProjectBussiness" value="FujifilmUSA.Sync.Business.Implementation.ProjectBussinessImpl" />
    <add key="IDestinationProfileBusiness" value="FujifilmUSA.Sync.Business.Implementation.DestinationProfileBusinessImpl" />
    <add key="ISourceProfileBusiness" value="FujifilmUSA.Sync.Business.Implementation.SourceProfileBusinessImpl" />
    <add key="IDeviceLinkProfileBusiness" value="FujifilmUSA.Sync.Business.Implementation.DeviceLinkProfileBusinessImpl" />
    <add key="IMeasurementDeviceBusiness" value="FujifilmUSA.Sync.Business.Implementation.MeasurementDeviceBusinessImpl" />
    <add key="IReferenceChartBusiness" value="FujifilmUSA.Sync.Business.Implementation.ReferenceChartBusinessImpl" />
    <add key="ISyncRunBusiness" value="FujifilmUSA.Sync.Business.Implementation.SyncRunBusinessImpl" />
    <add key="IMiscDataBusiness" value="FujifilmUSA.Sync.Business.Implementation.MiscDataBusinessImpl" />
    <add key="IMeasurementBusiness" value="FujifilmUSA.Sync.Business.Implementation.MeasurementBusinessImpl" />
    <add key="IProfilerOptionDetailBusiness" value="FujifilmUSA.Sync.Business.Implementation.ProfilerOptionDetailBusinessImpl" />-->
  </appSettings>
  
<connectionStrings>
    <add name="DevConnection" connectionString="Data Source=192.168.3.112;Initial Catalog=Fujifilm_Sync_Demo;Persist Security Info=True;User ID=sa;Password=softwebinc" providerName="System.Data.SqlClient" />
    <add name="StageConnection" connectionString="Data Source=192.168.3.112;Initial Catalog=Fujifilm_Sync_Demo;Persist Security Info=True;User ID=sa;Password=softwebinc" providerName="System.Data.SqlClient" />
  </connectionStrings>
<system.web>
      <compilation debug="true" targetFramework="4.0" />

      <pages theme="FujifilmSkin">
        <controls>
          <add assembly="Telerik.Web.UI" namespace="Telerik.Web.UI" tagPrefix="telerik" />
        </controls>
      </pages>
    <httpHandlers>
            <add path="ChartImage.axd" type="Telerik.Web.UI.ChartHttpHandler" verb="*" validate="false" />
            <add path="Telerik.Web.UI.SpellCheckHandler.axd" type="Telerik.Web.UI.SpellCheckHandler" verb="*" validate="false" />
            <add path="Telerik.Web.UI.DialogHandler.aspx" type="Telerik.Web.UI.DialogHandler" verb="*" validate="false" />
            <add path="Telerik.RadUploadProgressHandler.ashx" type="Telerik.Web.UI.RadUploadProgressHandler" verb="*" validate="false" />
            <add path="Telerik.Web.UI.WebResource.axd" type="Telerik.Web.UI.WebResource" verb="*" validate="false" /></httpHandlers>
    <httpModules />
      
    </system.web>
<system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <modules runAllManagedModulesForAllRequests="true" />
    <handlers>
            <remove name="ChartImage_axd" />
            
            <remove name="Telerik_Web_UI_SpellCheckHandler_axd" />
            <remove name="Telerik_Web_UI_DialogHandler_aspx" />
            <remove name="Telerik_RadUploadProgressHandler_ashx" />
            <remove name="Telerik_Web_UI_WebResource_axd" /><add name="ChartImage_axd" path="ChartImage.axd" type="Telerik.Web.UI.ChartHttpHandler" verb="*" preCondition="integratedMode" />
            <add name="Telerik_Web_UI_SpellCheckHandler_axd" path="Telerik.Web.UI.SpellCheckHandler.axd" type="Telerik.Web.UI.SpellCheckHandler" verb="*" preCondition="integratedMode" />
            <add name="Telerik_Web_UI_DialogHandler_aspx" path="Telerik.Web.UI.DialogHandler.aspx" type="Telerik.Web.UI.DialogHandler" verb="*" preCondition="integratedMode" />
            <add name="Telerik_RadUploadProgressHandler_ashx" path="Telerik.RadUploadProgressHandler.ashx" type="Telerik.Web.UI.RadUploadProgressHandler" verb="*" preCondition="integratedMode" />
            <add name="Telerik_Web_UI_WebResource_axd" path="Telerik.Web.UI.WebResource.axd" type="Telerik.Web.UI.WebResource" verb="*" preCondition="integratedMode" /></handlers></system.webServer>

</configuration>
