<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="MainMaster.master.cs" Inherits="FujifilmUSA.Sync.Web.Mock.MainMaster" %>
<%@ Import Namespace="FujifilmUSA.Sync.Common" %>
<%@ Register Src="~/UserControl/LeftMenu.ascx" TagName="LeftMenu" TagPrefix="uc1" %>
<%@ Register Src="~/UserControl/Header.ascx" TagName="Header" TagPrefix="uc1" %>
<%@ Register Src="~/UserControl/Footer.ascx" TagName="Footer" TagPrefix="uc1" %>
<!DOCTYPE html>
<html>

<head id="Head1" runat="server">
    <title>Fujifilm Color Path</title>
    <link href="CSS/Common.css" rel="stylesheet" type="text/css" />
    <script src="Javascript/html5.js" type="text/javascript"></script>
    <script src="JQuery/jquery-1.6.2.min.js" type="text/javascript"></script>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
    <asp:ScriptManager ID="ScriptManager1" runat="server">
    </asp:ScriptManager>
    <section id="bodyWrapper"> 
  <!--Start PageWrapper-->
  <div class="curve_top">&nbsp;</div>
  <section id="pageWrapper"> 
  	<uc1:Header ID="ucHeader" runat="server" />  
    <section id="containar">
    <script type="text/javascript" language="javascript">
    var title = '';
    function OpenInformationBox(url) {
        var oWnd = radopen(url, "RadModelWindow");
        if (url.indexOf("ModelControlId=1") >= 0) {
            title = "Open Print Condition";
            oWnd.setSize(650, 300);
        }
        if (url.indexOf("ModelControlId=2") >= 0) {
            title = "Close Print Condition";
            oWnd.setSize(650, 270);
        }
        if (url.indexOf("ModelControlId=3") >= 0) {
            title = "Download Chart";
            oWnd.setSize(650, 270);
        }
        oWnd.add_pageLoad(windowLoad);
        return false;
    }
    function windowLoad(oWindow, args) {
        oWindow.set_title(title);
        oWindow.set_status('');
    }
</script>
    <telerik:RadWindowManager ID="RadWindowManager" runat="server" 
    Modal="True" 
    >
    <Windows>
                <telerik:RadWindow 
                    id="RadModelWindow" 
                    runat="server"
                    showcontentduringload="false"
                    behaviors="Close, Move" Behavior="Close, Move"
                    >
                </telerik:RadWindow>
            </Windows>
</telerik:RadWindowManager>
      <section id="sidebar">      	
        	 <uc1:LeftMenu ID="LeftMenu2" runat="server" />        
      </section>
      <section id="contant">
          <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server"></asp:ContentPlaceHolder>
      </section>
      <div class="clear"></div>
    </section>
  </section>
  <div class="curve_bottom">&nbsp;</div>
  <!--End PageWrapper--> 
  <uc1:Footer ID="ucFooter" runat="server" />

</section>
    </form>
</body>
</html>

